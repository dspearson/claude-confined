#include <tunables/global>

profile claude-confined @{HOME}/.local/bin/claude-confined flags=(enforce) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  # Capabilities needed for user namespaces and sandboxing
  capability sys_admin,
  capability sys_chroot,
  capability setuid,
  capability setgid,
  capability setpcap,
  capability sys_ptrace,

  # Allow user namespace creation for bwrap
  userns,

  # Network access (comment out for no network)
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  # Bash interpreter (for the claude-confined script)
  /usr/bin/bash rix,
  /bin/bash rix,
  /usr/bin/dash rix,
  /bin/dash rix,

  # Bubblewrap execution (transition to named bwrap profile, not globally attached)
  /usr/bin/bwrap Px -> claude-confined-bwrap,
  /bin/bwrap Px -> claude-confined-bwrap,

  # Claude-confined script and related files
  @{HOME}/.local/bin/claude-confined r,

  # Seccomp filter generator
  @{HOME}/.local/lib/claude-confined/ r,
  @{HOME}/.local/lib/claude-confined/generate-seccomp rix,

  # Claude binary
  @{HOME}/.local/bin/claude rix,
  @{HOME}/.bun/bin/claude rix,

  # Required system libraries
  /usr/lib/** rm,
  /lib/** rm,
  /lib64/** rm,
  /usr/bin/** rix,
  /bin/** rix,

  # System information (read-only)
  /etc/ld.so.cache r,
  /etc/ld.so.conf r,
  /etc/ld.so.conf.d/ r,
  /etc/ld.so.conf.d/** r,
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/ssl/certs/ r,
  /etc/ssl/certs/** r,
  /etc/ca-certificates/** r,
  /etc/nsswitch.conf r,
  /etc/localtime r,
  /etc/java-*/ r,
  /etc/java-*/** r,

  # Proc filesystem (minimal access)
  /proc/ r,
  /proc/sys/kernel/random/uuid r,
  /proc/sys/kernel/overflowuid r,
  /proc/sys/kernel/overflowgid r,
  /proc/sys/vm/overcommit_memory r,
  /proc/*/stat r,
  /proc/*/status r,
  /proc/*/fd/ r,
  /proc/*/uid_map rw,
  /proc/*/gid_map rw,
  /proc/*/setgroups rw,
  /proc/meminfo r,
  /proc/cpuinfo r,

  # Device access (minimal)
  /dev/console rw,
  /dev/tty rw,
  /dev/null rw,
  /dev/zero r,
  /dev/random r,
  /dev/urandom r,
  /dev/pts/* rw,
  /dev/stdin rw,
  /dev/stdout rw,
  /dev/stderr rw,
  /proc/self/fd/* rw,

  # Claude directories (full access, includes tmp)
  owner @{HOME}/.claude/ rw,
  owner @{HOME}/.claude/** rw,
  owner @{HOME}/.claude.json rw,
  owner @{HOME}/.claude.json.lock/ rw,
  owner @{HOME}/.claude.json.lock/** rw,

  # Config directory (read-write)
  owner @{HOME}/.config/claude/ rw,
  owner @{HOME}/.config/claude/** rw,

  # System tmp (tmpfs from bwrap)
  /tmp/ rw,
  /tmp/** rw,

  # User bin directories (read-only for binaries)
  owner @{HOME}/.bin/ r,
  owner @{HOME}/.bin/** rix,
  owner @{HOME}/.config/emacs/bin/ r,
  owner @{HOME}/.config/emacs/bin/** rix,
  owner @{HOME}/.cargo/bin/ r,
  owner @{HOME}/.cargo/bin/** rix,
  owner @{HOME}/.rustup/ r,
  owner @{HOME}/.rustup/** rix,
  owner @{HOME}/.nix-profile/bin/ r,
  owner @{HOME}/.nix-profile/bin/** rix,

  # Bun runtime
  owner @{HOME}/.bun/ rw,
  owner @{HOME}/.bun/** rwlk,

  # Clojure configuration and cache
  owner @{HOME}/.clojure/ rw,
  owner @{HOME}/.clojure/** rwlk,

  # Nix store (read and execute)
  /nix/ r,
  /nix/** rix,

  # SSH keys (via ~/.claude/ssh mapped to ~/.ssh)
  owner @{HOME}/.ssh/ rw,
  owner @{HOME}/.ssh/** rw,

  # Deny access to sensitive files
  audit deny @{HOME}/.gnupg/** rwlkx,
  audit deny @{HOME}/.bash_history rwlkx,
  audit deny @{HOME}/.zsh_history rwlkx,
  audit deny @{HOME}/.lesshst rwlkx,
  audit deny @{HOME}/.viminfo rwlkx,
  audit deny @{HOME}/.netrc rwlkx,
  audit deny @{HOME}/.aws/** rwlkx,
  audit deny @{HOME}/.docker/** rwlkx,
  audit deny @{HOME}/.kube/** rwlkx,
  audit deny /etc/shadow rwlkx,
  audit deny /etc/sudoers rwlkx,
  audit deny /etc/sudoers.d/** rwlkx,
  audit deny /root/** rwlkx,

  # Deny dangerous commands completely
  audit deny /bin/su rwx,
  audit deny /bin/sudo rwx,
  audit deny /usr/bin/sudo rwx,
  audit deny /usr/bin/su rwx,
  audit deny /sbin/su rwx,
  audit deny /usr/sbin/su rwx,
  audit deny /sbin/sudo rwx,
  audit deny /usr/sbin/sudo rwx,
  audit deny /bin/mount rwx,
  audit deny /bin/umount rwx,
  audit deny /usr/bin/mount rwx,
  audit deny /usr/bin/umount rwx,

  # Signal permissions
  signal (receive) peer=unconfined,
  signal (send) peer=claude-confined,
}

# Named profile for bwrap - only activated via transition, not globally attached
profile claude-confined-bwrap flags=(attach_disconnected,mediate_deleted) {
    # Allow all capabilities needed for namespace setup
    capability,

    # User namespace permission
    userns,

    # Mount operations
    mount,
    umount,
    pivot_root,

    # File access - read/write/link but exec controlled by pix below
    file rwlk /{**,},

    # Network
    network,
    unix,

    # Process control
    ptrace,
    signal,

    # Stack the unpriv profile on all executed binaries
    # This removes capabilities inside the namespace
    pix /** -> &claude-confined-bwrap//&claude-confined-unpriv,

    include if exists <local/claude-confined-bwrap>
}

# Named profile for processes inside the namespace - no capabilities, only via stacking
profile claude-confined-unpriv flags=(attach_disconnected,mediate_deleted) {
    # Deny dangerous system commands
    audit deny /bin/su rwx,
    audit deny /bin/sudo rwx,
    audit deny /usr/bin/sudo rwx,
    audit deny /usr/bin/su rwx,
    audit deny /sbin/su rwx,
    audit deny /usr/sbin/su rwx,
    audit deny /sbin/sudo rwx,
    audit deny /usr/sbin/sudo rwx,
    audit deny /bin/mount rwx,
    audit deny /bin/umount rwx,
    audit deny /usr/bin/mount rwx,
    audit deny /usr/bin/umount rwx,
    audit deny /sbin/mount rwx,
    audit deny /sbin/umount rwx,

    # Deny system sensitive files
    audit deny /etc/shadow rwlkx,
    audit deny /etc/sudoers rwlkx,
    audit deny /etc/sudoers.d/** rwlkx,
    audit deny /etc/passwd w,
    audit deny /etc/group w,
    audit deny /root/** rwlkx,

    # Deny sensitive home directory files and credentials
    audit deny @{HOME}/.gnupg/** rwlkx,
    audit deny @{HOME}/.bash_history rwlkx,
    audit deny @{HOME}/.zsh_history rwlkx,
    audit deny @{HOME}/.lesshst rwlkx,
    audit deny @{HOME}/.viminfo rwlkx,
    audit deny @{HOME}/.netrc rwlkx,
    audit deny @{HOME}/.aws/** rwlkx,
    audit deny @{HOME}/.docker/** rwlkx,
    audit deny @{HOME}/.kube/** rwlkx,
    audit deny @{HOME}/.mysql_history rwlkx,
    audit deny @{HOME}/.psql_history rwlkx,
    audit deny @{HOME}/.python_history rwlkx,
    audit deny @{HOME}/.gem/credentials rwlkx,
    audit deny @{HOME}/.npmrc rwlkx,
    audit deny @{HOME}/.pypirc rwlkx,
    audit deny @{HOME}/.cargo/credentials* rwlkx,

    # Deny other common sensitive dotfiles
    # Note: .ssh is explicitly allowed via bwrap mapping from ~/.claude/ssh
    audit deny @{HOME}/.pgpass rwlkx,
    audit deny @{HOME}/.s3cfg rwlkx,
    audit deny @{HOME}/.boto rwlkx,
    audit deny @{HOME}/.config/gcloud/** rwlkx,
    audit deny @{HOME}/.azure/** rwlkx,
    audit deny @{HOME}/.helm/** rwlkx,

    # Deny all capabilities inside the namespace
    audit deny capability,

    # Allow rules
    # Root and critical directories (directory listing)
    # REQUIRED FOR COLORS: Directory read access allows process navigation
    / r,
    /*/ r,
    owner @{HOME}/ r,
    /proc/ r,

    # System directories (read-only, mmap, execute with profile transition)
    /usr/** mrpix -> &claude-confined-unpriv,
    /lib/** mrpix -> &claude-confined-unpriv,
    /lib64/** mrpix -> &claude-confined-unpriv,
    /bin/** mrpix -> &claude-confined-unpriv,
    /sbin/** mrpix -> &claude-confined-unpriv,
    /etc/** r,
    /proc/** r,
    /sys/** r,

    # Device access (specific devices only, identified via audit logging)
    /dev/null rw,
    /dev/zero r,
    /dev/random r,
    /dev/urandom r,
    /dev/pts/* rw,

    # Nix store (read, mmap, execute with profile transition)
    /nix/** mrpix -> &claude-confined-unpriv,

    # Writable system temp
    /tmp/ r,
    /tmp/** rwlkmpix -> &claude-confined-unpriv,

    # Claude directories (read-write)
    owner @{HOME}/.claude/ r,
    owner @{HOME}/.claude/** rwlkmpix -> &claude-confined-unpriv,
    owner @{HOME}/.config/claude/ r,
    owner @{HOME}/.config/claude/** rwlkmpix -> &claude-confined-unpriv,
    owner @{HOME}/.claude.json* rwlkmpix -> &claude-confined-unpriv,
    owner @{HOME}/.claude.json.lock/ r,
    owner @{HOME}/.claude.json.lock/** rwlkmpix -> &claude-confined-unpriv,

    # SSH keys - ONLY from ~/.claude/ssh (bwrap mounts ~/.claude/ssh as ~/.ssh)
    owner @{HOME}/.ssh/ r,
    owner @{HOME}/.ssh/** rwmpix -> &claude-confined-unpriv,

    # User bin directories
    owner @{HOME}/.bin/** mrpix -> &claude-confined-unpriv,
    owner @{HOME}/.config/emacs/bin/** mrpix -> &claude-confined-unpriv,
    owner @{HOME}/.cargo/bin/** mrpix -> &claude-confined-unpriv,
    owner @{HOME}/.nix-profile/bin/** mrpix -> &claude-confined-unpriv,

    # Cargo (full access except credentials which are denied above)
    owner @{HOME}/.cargo/ r,
    owner @{HOME}/.cargo/** rwlkmpix -> &claude-confined-unpriv,

    # Rustup toolchain manager
    owner @{HOME}/.rustup/ r,
    owner @{HOME}/.rustup/** rwlkmpix -> &claude-confined-unpriv,

    # Bun runtime (with directory access, write for caches/locks, execute for vendored binaries)
    # REQUIRED FOR COLORS: Execute permission (pix) needed for vendored binaries like ripgrep
    owner @{HOME}/.bun/ r,
    owner @{HOME}/.bun/** rwlkmpix -> &claude-confined-unpriv,

    # Clojure configuration and cache
    owner @{HOME}/.clojure/ r,
    owner @{HOME}/.clojure/** rwlkmpix -> &claude-confined-unpriv,

    # Git configuration (read-only)
    owner @{HOME}/.gitconfig mr,
    owner @{HOME}/.config/git/** mrpix -> &claude-confined-unpriv,

    # XDG directories
    owner @{HOME}/.cache/** rwlkmpix -> &claude-confined-unpriv,
    owner @{HOME}/.local/share/** rwlkmpix -> &claude-confined-unpriv,
    audit deny @{HOME}/.local/share/keyrings/** rwlkx,

    # Project directories under $HOME (read-write with execute, but NOT dotfiles)
    # [^.] ensures we don't match hidden directories to avoid conflicts
    owner @{HOME}/[^.]* rwlkmpix -> &claude-confined-unpriv,
    owner @{HOME}/[^.]*/** rwlkmpix -> &claude-confined-unpriv,

    # Allow any user-owned paths bind-mounted by bwrap (after deny rules)
    # This allows project directories in arbitrary locations (e.g., /workspace, /zpool)
    # Safe because: deny rules above block sensitive files, and 'owner' restricts to user's files
    owner /** rwlkmpix -> &claude-confined-unpriv,

    # Network
    network,
    unix,

    # Process control
    ptrace,
    signal,

    # Namespace operations (no new capabilities granted)
    userns,
    mount,
    umount,
    pivot_root,

    include if exists <local/claude-confined-unpriv>
}
