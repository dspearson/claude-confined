#!/bin/bash
# claude-confined - Run Claude Code in a sandboxed environment
# This script restricts Claude's access to the filesystem and system resources
#
# On Linux: Uses bubblewrap (bwrap) + AppArmor + seccomp
# On macOS: Uses sandbox-exec with Seatbelt profiles
#
# Usage: claude-confined [--allow PATH]... [--ro-allow PATH]... [claude-options]

set -euo pipefail

# Detect operating system
OS_TYPE="$(uname -s)"

# Configuration
CLAUDE_DIR="${HOME}/.claude"
CLAUDE_TMP="${CLAUDE_DIR}/tmp"
CLAUDE_CONFIG="${HOME}/.config/claude"

# Arrays for additional paths
declare -a ADDITIONAL_RW_PATHS=()
declare -a ADDITIONAL_RO_PATHS=()

# Debug mode - run arbitrary bash command instead of claude
DEBUG_COMMAND=""

# Flow mode - run ruflo instead of claude
FLOW_MODE=false
FLOW_ARGS=()

# Add current working directory by default
INITIAL_CWD=$(pwd -P)

# Refuse to run if executed in user's $HOME or any parent directory of $HOME
# This prevents granting access to the entire home directory or /home
# Check if $HOME starts with $INITIAL_CWD (meaning CWD is at or above HOME)
if [[ "${HOME}" == "${INITIAL_CWD}"* ]]; then
    if [[ "${INITIAL_CWD}" == "${HOME}" ]]; then
        echo "Error: refusing to run in \$HOME" >&2
    else
        echo "Error: refusing to run in a directory that would include sharing your entire \$HOME" >&2
    fi
    echo "Please cd to a specific project directory first." >&2
    exit 1
fi

# Parse arguments
CLAUDE_ARGS=()

# Add --dangerously-skip-permissions if env var is set
if [[ -n "${DANGEROUSLY_SKIP_PERMISSIONS:-}" ]]; then
    CLAUDE_ARGS+=("--dangerously-skip-permissions")
fi

while [[ $# -gt 0 ]]; do
    case $1 in
        --allow)
            if [[ $# -lt 2 ]]; then
                echo "Error: --allow requires a path argument" >&2
                exit 1
            fi
            shift
            # Store as "real_path:bind_target" - if symlink, preserve the symlink path
            if [[ -L "$1" ]]; then
                real_path="$(realpath "$1")"
                symlink_path="$1"
                ADDITIONAL_RW_PATHS+=("${real_path}:${symlink_path}")
            else
                real_path="$(realpath "$1")"
                ADDITIONAL_RW_PATHS+=("${real_path}:${real_path}")
            fi
            shift
            ;;
        --ro-allow)
            if [[ $# -lt 2 ]]; then
                echo "Error: --ro-allow requires a path argument" >&2
                exit 1
            fi
            shift
            # Store as "real_path:bind_target" - if symlink, preserve the symlink path
            if [[ -L "$1" ]]; then
                real_path="$(realpath "$1")"
                symlink_path="$1"
                ADDITIONAL_RO_PATHS+=("${real_path}:${symlink_path}")
            else
                real_path="$(realpath "$1")"
                ADDITIONAL_RO_PATHS+=("${real_path}:${real_path}")
            fi
            shift
            ;;
        --bash)
            if [[ $# -lt 2 ]]; then
                echo "Error: --bash requires a command argument" >&2
                exit 1
            fi
            shift
            DEBUG_COMMAND="$1"
            shift
            ;;
        --flow)
            FLOW_MODE=true
            shift
            # Collect all remaining arguments for ruflo
            while [[ $# -gt 0 ]]; do
                FLOW_ARGS+=("$1")
                shift
            done
            ;;
        --help)
            cat <<EOF
Usage: claude-confined [OPTIONS] [CLAUDE_ARGS...]

Run Claude Code in a sandboxed environment with restricted filesystem access.

Platform support:
  Linux   Uses bubblewrap (bwrap) + AppArmor + seccomp
  macOS   Uses sandbox-exec with Seatbelt profiles

Sandbox options:
  --allow PATH        Allow read-write access to PATH (can be specified multiple times)
  --ro-allow PATH     Allow read-only access to PATH (can be specified multiple times)
  --bash COMMAND      Run arbitrary command in sandbox instead of claude (for debugging)
  --flow [ARGS...]    Run ruflo instead of claude (all remaining args passed to ruflo)
  --help              Show this help message

Environment variables:
  DANGEROUSLY_SKIP_PERMISSIONS  If set, automatically pass --dangerously-skip-permissions to claude

By default, the current working directory and ~/.claude are accessible.
Ruflo directories (~/.swarm, ~/.claude-flow, ~/.hive-mind) are also accessible.

All other arguments are passed to claude (or ruflo with --flow).

Examples:
  claude-confined --allow /path/to/project
  claude-confined --allow /home/user/project1 --ro-allow /home/user/docs
  claude-confined --allow . chat
  claude-confined --dangerously-skip-permissions
  claude-confined --flow --version
  claude-confined --flow memory store key "value" --namespace test
  claude-confined --flow swarm "build REST API"
  DANGEROUSLY_SKIP_PERMISSIONS=1 claude-confined

EOF
            exit 0
            ;;
        *)
            CLAUDE_ARGS+=("$1")
            shift
            ;;
    esac
done

# Ensure directories exist
mkdir -p "${CLAUDE_DIR}"
mkdir -p "${CLAUDE_TMP}"
mkdir -p "${CLAUDE_CONFIG}"

# Load global prompt if it exists
GLOBAL_PROMPT_FILE="${CLAUDE_DIR}/global-prompt"
if [[ -f "${GLOBAL_PROMPT_FILE}" ]]; then
    GLOBAL_PROMPT_CONTENT=$(cat "${GLOBAL_PROMPT_FILE}")
    if [[ -n "${GLOBAL_PROMPT_CONTENT}" ]]; then
        CLAUDE_ARGS=("--append-system-prompt" "${GLOBAL_PROMPT_CONTENT}" "${CLAUDE_ARGS[@]}")
    fi
fi

# Cross-platform realpath function (macOS doesn't have readlink -f)
resolve_path() {
    if [[ "${OS_TYPE}" == "Darwin" ]]; then
        # Use Python as fallback on macOS (always available)
        python3 -c "import os; print(os.path.realpath('$1'))"
    else
        readlink -f "$1"
    fi
}

# Find claude (not needed for --bash debug mode)
if [[ -z "${DEBUG_COMMAND}" ]] && [[ "${FLOW_MODE}" == "false" ]]; then
    CLAUDE_BIN=$(command -v claude)
    if [ -z "${CLAUDE_BIN}" ]; then
        echo "Error: claude not found in PATH" >&2
        exit 1
    fi

    # Resolve to the actual binary
    CLAUDE_REAL=$(resolve_path "${CLAUDE_BIN}")
fi

# ============================================================================
# macOS Sandbox Implementation (using sandbox-exec with Seatbelt profiles)
# ============================================================================

generate_macos_sandbox_profile() {
    # Generate a Seatbelt profile (SBPL) for macOS sandbox-exec
    # Whitelist-only model: only explicitly allowed paths are accessible
    # This mirrors the Linux bwrap bind-mount approach

    local profile=""

    # Start with version and deny-by-default
    profile+="(version 1)"$'\n'
    profile+="(deny default)"$'\n'

    # ========================================================================
    # Process execution - whitelist only
    # ========================================================================
    profile+="(allow process-fork)"$'\n'

    # Allow execution from system and dev tool paths
    profile+="(allow process-exec (subpath \"/usr\"))"$'\n'
    profile+="(allow process-exec (subpath \"/bin\"))"$'\n'
    profile+="(allow process-exec (subpath \"/sbin\"))"$'\n'
    profile+="(allow process-exec (subpath \"/opt/homebrew\"))"$'\n'
    profile+="(allow process-exec (subpath \"/Library/Developer\"))"$'\n'
    profile+="(allow process-exec (subpath \"${HOME}/.bun\"))"$'\n'
    profile+="(allow process-exec (subpath \"${HOME}/.cargo/bin\"))"$'\n'
    profile+="(allow process-exec (subpath \"${HOME}/.local/bin\"))"$'\n'
    profile+="(allow process-exec (subpath \"${HOME}/.nvm\"))"$'\n'
    profile+="(allow process-exec (subpath \"${HOME}/.rustup\"))"$'\n'
    profile+="(allow process-exec (subpath \"${HOME}/.nix-profile/bin\"))"$'\n'
    profile+="(allow process-exec (subpath \"${HOME}/.bin\"))"$'\n'
    profile+="(allow process-exec (subpath \"${HOME}/.config/emacs/bin\"))"$'\n'
    profile+="(allow process-exec (subpath \"${INITIAL_CWD}\"))"$'\n'

    # Deny dangerous commands (overrides the allows above)
    profile+="(deny process-exec (literal \"/usr/bin/sudo\"))"$'\n'
    profile+="(deny process-exec (literal \"/usr/bin/su\"))"$'\n'
    profile+="(deny process-exec (literal \"/usr/bin/login\"))"$'\n'
    profile+="(deny process-exec (literal \"/usr/bin/doas\"))"$'\n'
    profile+="(deny process-exec (literal \"/sbin/mount\"))"$'\n'
    profile+="(deny process-exec (literal \"/sbin/umount\"))"$'\n'
    profile+="(deny process-exec (literal \"/usr/sbin/diskutil\"))"$'\n'
    profile+="(deny process-exec (literal \"/usr/bin/security\"))"$'\n'

    # Allow signals within sandbox only
    profile+="(allow signal (target same-sandbox))"$'\n'

    # ========================================================================
    # System read access (equivalent to bwrap ro-bind)
    # ========================================================================
    profile+="(allow file-read* (literal \"/\"))"$'\n'
    profile+="(allow file-read* (subpath \"/usr\"))"$'\n'
    profile+="(allow file-read* (subpath \"/bin\"))"$'\n'
    profile+="(allow file-read* (subpath \"/sbin\"))"$'\n'
    profile+="(allow file-read* (subpath \"/Library\"))"$'\n'
    profile+="(allow file-read* (subpath \"/System\"))"$'\n'
    profile+="(allow file-read* (subpath \"/private/etc\"))"$'\n'
    profile+="(allow file-read* (subpath \"/private/var\"))"$'\n'
    profile+="(allow file-read* (subpath \"/var\"))"$'\n'
    profile+="(allow file-read* (literal \"/etc\"))"$'\n'
    profile+="(allow file-read* (subpath \"/etc\"))"$'\n'
    profile+="(allow file-read* (literal \"/tmp\"))"$'\n'
    profile+="(allow file-read* (literal \"/private/tmp\"))"$'\n'
    profile+="(allow file-read* (literal \"/dev/null\"))"$'\n'
    profile+="(allow file-read* (literal \"/dev/random\"))"$'\n'
    profile+="(allow file-read* (literal \"/dev/urandom\"))"$'\n'

    # Homebrew paths (Intel and Apple Silicon)
    profile+="(allow file-read* (subpath \"/opt/homebrew\"))"$'\n'
    profile+="(allow file-read* (subpath \"/usr/local\"))"$'\n'

    # Dev devices
    profile+="(allow file-write* (literal \"/dev/null\"))"$'\n'
    profile+="(allow file-write* (regex #\"^/dev/ttys[0-9]+$\"))"$'\n'
    profile+="(allow file-write* (literal \"/dev/ptmx\"))"$'\n'
    profile+="(allow file-read* (regex #\"^/dev/ttys[0-9]+$\"))"$'\n'
    profile+="(allow file-read* (literal \"/dev/ptmx\"))"$'\n'
    profile+="(allow file-ioctl (regex #\"^/dev/ttys[0-9]+$\"))"$'\n'
    profile+="(allow pseudo-tty)"$'\n'

    # Nix store (if exists)
    profile+="(allow file-read* (subpath \"/nix\"))"$'\n'

    # ========================================================================
    # Home directory - WHITELIST ONLY (mirrors Linux bwrap bind mounts)
    # No broad $HOME read access. Only explicitly listed paths are accessible.
    # ========================================================================

    # Deny credentials that live under otherwise-allowed paths
    # (file-read-data and file-read-metadata needed on macOS 26+ to override allows)
    profile+="(deny file-read-data (regex #\"\.cargo/credentials\"))"$'\n'
    profile+="(deny file-read-metadata (regex #\"\.cargo/credentials\"))"$'\n'
    profile+="(deny file-write* (regex #\"\.cargo/credentials\"))"$'\n'
    profile+="(deny file-read-data (subpath \"${HOME}/.local/share/keyrings\"))"$'\n'
    profile+="(deny file-read-metadata (subpath \"${HOME}/.local/share/keyrings\"))"$'\n'
    profile+="(deny file-write* (subpath \"${HOME}/.local/share/keyrings\"))"$'\n'

    # Claude directories (read-write)
    profile+="(allow file-read* (subpath \"${CLAUDE_DIR}\"))"$'\n'
    profile+="(allow file-write* (subpath \"${CLAUDE_DIR}\"))"$'\n'
    profile+="(allow file-read* (literal \"${HOME}/.claude.json\"))"$'\n'
    profile+="(allow file-write* (literal \"${HOME}/.claude.json\"))"$'\n'
    profile+="(allow file-read* (subpath \"${CLAUDE_CONFIG}\"))"$'\n'
    profile+="(allow file-write* (subpath \"${CLAUDE_CONFIG}\"))"$'\n'

    # Ruflo directories (read-write)
    profile+="(allow file-read* (subpath \"${HOME}/.swarm\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.swarm\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.claude-flow\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.claude-flow\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.hive-mind\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.hive-mind\"))"$'\n'

    # GitHub/GitLab CLI (read-write)
    profile+="(allow file-read* (subpath \"${HOME}/.config/gh\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.config/gh\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.config/glab-cli\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.config/glab-cli\"))"$'\n'

    # Node/npm (read-write)
    profile+="(allow file-read* (subpath \"${HOME}/.npm\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.npm\"))"$'\n'

    # Bun runtime (read-write, kept for tools that still use bun)
    profile+="(allow file-read* (subpath \"${HOME}/.bun\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.bun\"))"$'\n'

    # JavaScript/Node
    profile+="(allow file-read* (subpath \"${HOME}/.nvm\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/node_modules\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/node_modules\"))"$'\n'

    # Cargo/Rust (read-write, credentials denied above)
    profile+="(allow file-read* (subpath \"${HOME}/.cargo\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.cargo\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.rustup\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.rustup\"))"$'\n'

    # Clojure/Maven
    profile+="(allow file-read* (subpath \"${HOME}/.clojure\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.clojure\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.m2\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.m2\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.gitlibs\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.gitlibs\"))"$'\n'

    # Git configuration (read-only)
    profile+="(allow file-read* (literal \"${HOME}/.gitconfig\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.config/git\"))"$'\n'

    # XDG directories (read-write, keyrings denied above)
    profile+="(allow file-read* (subpath \"${HOME}/.local/share\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.local/share\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.cache\"))"$'\n'
    profile+="(allow file-write* (subpath \"${HOME}/.cache\"))"$'\n'

    # User bin directories (read-only/execute)
    profile+="(allow file-read* (subpath \"${HOME}/.bin\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.local/bin\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.config/emacs/bin\"))"$'\n'
    profile+="(allow file-read* (subpath \"${HOME}/.nix-profile/bin\"))"$'\n'

    # Current working directory (read-write)
    profile+="(allow file-read* (subpath \"${INITIAL_CWD}\"))"$'\n'
    profile+="(allow file-write* (subpath \"${INITIAL_CWD}\"))"$'\n'

    # Additional read-write paths (--allow)
    if [[ ${#ADDITIONAL_RW_PATHS[@]} -gt 0 ]]; then
        for path_pair in "${ADDITIONAL_RW_PATHS[@]}"; do
            IFS=':' read -r source_path target_path <<< "${path_pair}"
            if [[ -e "${source_path}" ]]; then
                profile+="(allow file-read* (subpath \"${source_path}\"))"$'\n'
                profile+="(allow file-write* (subpath \"${source_path}\"))"$'\n'
            fi
        done
    fi

    # Additional read-only paths (--ro-allow)
    if [[ ${#ADDITIONAL_RO_PATHS[@]} -gt 0 ]]; then
        for path_pair in "${ADDITIONAL_RO_PATHS[@]}"; do
            IFS=':' read -r source_path target_path <<< "${path_pair}"
            if [[ -e "${source_path}" ]]; then
                profile+="(allow file-read* (subpath \"${source_path}\"))"$'\n'
            fi
        done
    fi

    # ========================================================================
    # Temp directories (read-write)
    # ========================================================================
    profile+="(allow file-read* (subpath \"/private/var/folders\"))"$'\n'
    profile+="(allow file-write* (subpath \"/private/var/folders\"))"$'\n'
    profile+="(allow file-write* (subpath \"/private/tmp\"))"$'\n'

    # ========================================================================
    # Network (required for API calls)
    # ========================================================================
    profile+="(allow network-outbound)"$'\n'
    profile+="(allow network-inbound)"$'\n'
    profile+="(allow system-socket)"$'\n'

    # ========================================================================
    # System services
    # ========================================================================
    profile+="(allow mach-lookup)"$'\n'
    profile+="(allow sysctl-read)"$'\n'
    profile+="(allow iokit-open)"$'\n'
    profile+="(allow user-preference-read)"$'\n'

    # Process info
    profile+="(allow process-info-pidinfo)"$'\n'
    profile+="(allow process-info-setcontrol)"$'\n'
    profile+="(allow process-info-dirtycontrol)"$'\n'

    echo "${profile}"
}

run_macos_sandbox() {
    local cmd_to_run=("$@")

    # Check for sandbox-exec availability
    if ! command -v sandbox-exec >/dev/null 2>&1; then
        echo "Error: sandbox-exec not found. macOS sandboxing unavailable." >&2
        exit 1
    fi

    # Generate the sandbox profile
    local profile
    profile=$(generate_macos_sandbox_profile)

    # Execute with sandbox
    exec sandbox-exec -p "${profile}" "${cmd_to_run[@]}"
}

# ============================================================================
# macOS execution path
# ============================================================================

if [[ "${OS_TYPE}" == "Darwin" ]]; then
    # macOS sandbox using sandbox-exec

    if [[ -n "${DEBUG_COMMAND}" ]]; then
        # Debug mode - run arbitrary command
        run_macos_sandbox /bin/bash -c "${DEBUG_COMMAND}"
    elif [[ "${FLOW_MODE}" == "true" ]]; then
        # Flow mode - run ruflo
        RUFLO_BIN=""
        if command -v ruflo >/dev/null 2>&1; then
            RUFLO_BIN=$(command -v ruflo)
        fi

        if [[ -n "${RUFLO_BIN}" ]]; then
            RUFLO_REAL=$(resolve_path "${RUFLO_BIN}")
            run_macos_sandbox "${RUFLO_REAL}" ${FLOW_ARGS[@]+"${FLOW_ARGS[@]}"}
        else
            FLOW_PACKAGE="${RUFLO_PACKAGE:-ruflo@latest}"
            echo "Warning: ruflo not found globally, using: npx ${FLOW_PACKAGE}" >&2
            NPX_BIN=$(command -v npx)
            if [ -z "${NPX_BIN}" ]; then
                echo "Error: npx not found in PATH" >&2
                exit 1
            fi
            NPX_REAL=$(resolve_path "${NPX_BIN}")
            run_macos_sandbox "${NPX_REAL}" "${FLOW_PACKAGE}" ${FLOW_ARGS[@]+"${FLOW_ARGS[@]}"}
        fi
    else
        # Normal mode - run claude
        run_macos_sandbox "${CLAUDE_REAL}" ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}
    fi

    # Should never reach here due to exec
    exit 0
fi

# ============================================================================
# Linux Sandbox Implementation (using bubblewrap + AppArmor + seccomp)
# ============================================================================

# Verify we're on Linux (if not macOS and not Linux, exit)
if [[ "${OS_TYPE}" != "Linux" ]]; then
    echo "Error: Unsupported operating system: ${OS_TYPE}" >&2
    echo "Supported platforms: Linux, Darwin (macOS)" >&2
    exit 1
fi

# Check for bwrap availability
if ! command -v bwrap >/dev/null 2>&1; then
    echo "Error: bubblewrap (bwrap) not found. Please install it:" >&2
    echo "  Debian/Ubuntu: sudo apt install bubblewrap" >&2
    echo "  Fedora: sudo dnf install bubblewrap" >&2
    echo "  Arch: sudo pacman -S bubblewrap" >&2
    exit 1
fi

# Build the bwrap command - start with base system bindings
BWRAP_ARGS=(
    --ro-bind /usr /usr
    --ro-bind /lib /lib
    --ro-bind /lib64 /lib64
    --ro-bind /bin /bin
    --ro-bind /sbin /sbin
    --ro-bind /etc/resolv.conf /etc/resolv.conf
    --ro-bind /etc/hosts /etc/hosts
    --ro-bind /etc/passwd /etc/passwd
    --ro-bind /etc/group /etc/group
    --ro-bind /etc/nsswitch.conf /etc/nsswitch.conf
    --ro-bind /etc/ssl /etc/ssl
    --ro-bind /etc/ca-certificates /etc/ca-certificates
    --ro-bind /usr/share/terminfo /usr/share/terminfo
    --bind $HOME/node_modules $HOME/node_modules
    --proc /proc
    --dev /dev
    --tmpfs /tmp
)

# Additional system configuration (conditional)
[[ -f /etc/ld.so.conf ]] && BWRAP_ARGS+=(--ro-bind /etc/ld.so.conf /etc/ld.so.conf)
[[ -f /etc/ld.so.cache ]] && BWRAP_ARGS+=(--ro-bind /etc/ld.so.cache /etc/ld.so.cache)
[[ -d /etc/ld.so.conf.d ]] && BWRAP_ARGS+=(--ro-bind /etc/ld.so.conf.d /etc/ld.so.conf.d)
[[ -f /etc/localtime ]] && BWRAP_ARGS+=(--ro-bind /etc/localtime /etc/localtime)
[[ -f /etc/timezone ]] && BWRAP_ARGS+=(--ro-bind /etc/timezone /etc/timezone)
[[ -f /etc/gitconfig ]] && BWRAP_ARGS+=(--ro-bind /etc/gitconfig /etc/gitconfig)
[[ -d /etc/bash_completion.d ]] && BWRAP_ARGS+=(--ro-bind /etc/bash_completion.d /etc/bash_completion.d)

# Debian alternatives system (conditional)
[[ -d /etc/alternatives ]] && BWRAP_ARGS+=(--ro-bind /etc/alternatives /etc/alternatives)

# AppArmor integration
if command -v aa-exec >/dev/null 2>&1 && [[ -d /sys/kernel/security/apparmor ]]; then
    BWRAP_ARGS+=(--ro-bind /sys/kernel/security /sys/kernel/security)
fi

# Additional terminfo locations (conditional)
[[ -d /lib/terminfo ]] && BWRAP_ARGS+=(--ro-bind /lib/terminfo /lib/terminfo)
[[ -d /etc/terminfo ]] && BWRAP_ARGS+=(--ro-bind /etc/terminfo /etc/terminfo)

# Locale and documentation (conditional)
[[ -d /usr/lib/locale ]] && BWRAP_ARGS+=(--ro-bind /usr/lib/locale /usr/lib/locale)
[[ -d /usr/share/locale ]] && BWRAP_ARGS+=(--ro-bind /usr/share/locale /usr/share/locale)
[[ -d /usr/share/man ]] && BWRAP_ARGS+=(--ro-bind /usr/share/man /usr/share/man)

# Java configuration directories (conditional, for JVM-based tools like Clojure)
# Check for common Java version directories
if [[ -d /etc/java-26-openjdk ]]; then
    BWRAP_ARGS+=(--ro-bind /etc/java-26-openjdk /etc/java-26-openjdk)
fi
if [[ -d /etc/java-21-openjdk ]]; then
    BWRAP_ARGS+=(--ro-bind /etc/java-21-openjdk /etc/java-21-openjdk)
fi
if [[ -d /etc/java-17-openjdk ]]; then
    BWRAP_ARGS+=(--ro-bind /etc/java-17-openjdk /etc/java-17-openjdk)
fi
if [[ -d /etc/java-11-openjdk ]]; then
    BWRAP_ARGS+=(--ro-bind /etc/java-11-openjdk /etc/java-11-openjdk)
fi

# Bind user-specific paths (read-only)
[[ -d "${HOME}/.bin" ]] && BWRAP_ARGS+=(--ro-bind "${HOME}/.bin" "${HOME}/.bin")
[[ -d "${HOME}/.local/bin" ]] && BWRAP_ARGS+=(--ro-bind "${HOME}/.local/bin" "${HOME}/.local/bin")
[[ -d "${HOME}/.config/emacs/bin" ]] && BWRAP_ARGS+=(--ro-bind "${HOME}/.config/emacs/bin" "${HOME}/.config/emacs/bin")
[[ -d "${HOME}/.cargo/bin" ]] && BWRAP_ARGS+=(--ro-bind "${HOME}/.cargo/bin" "${HOME}/.cargo/bin")
[[ -d "${HOME}/.rustup" ]] && BWRAP_ARGS+=(--bind "${HOME}/.rustup" "${HOME}/.rustup")
[[ -d "${HOME}/.nix-profile/bin" ]] && BWRAP_ARGS+=(--ro-bind "${HOME}/.nix-profile/bin" "${HOME}/.nix-profile/bin")

# JavaScript/Node runtimes
[[ -d "${HOME}/.nvm" ]] && BWRAP_ARGS+=(--ro-bind "${HOME}/.nvm" "${HOME}/.nvm")
[[ -d "${HOME}/.npm" ]] && BWRAP_ARGS+=(--bind "${HOME}/.npm" "${HOME}/.npm")
[[ -d "${HOME}/.bun" ]] && BWRAP_ARGS+=(--bind "${HOME}/.bun" "${HOME}/.bun")

# Clojure configuration and cache
[[ -d "${HOME}/.clojure" ]] && BWRAP_ARGS+=(--bind "${HOME}/.clojure" "${HOME}/.clojure")
[[ -d "${HOME}/.m2" ]] && BWRAP_ARGS+=(--bind "${HOME}/.m2" "${HOME}/.m2")
[[ -d "${HOME}/.gitlibs" ]] && BWRAP_ARGS+=(--bind "${HOME}/.gitlibs" "${HOME}/.gitlibs")

# XDG directories for application data and cache
[[ -d "${HOME}/.local/share" ]] && BWRAP_ARGS+=(--bind "${HOME}/.local/share" "${HOME}/.local/share")
[[ -d "${HOME}/.cache" ]] && BWRAP_ARGS+=(--bind "${HOME}/.cache" "${HOME}/.cache")

# Git configuration (read-only)
[[ -f "${HOME}/.gitconfig" ]] && BWRAP_ARGS+=(--ro-bind "${HOME}/.gitconfig" "${HOME}/.gitconfig")
[[ -d "${HOME}/.config/git" ]] && BWRAP_ARGS+=(--ro-bind "${HOME}/.config/git" "${HOME}/.config/git")

# GitHub/GitLab CLI configuration (read-write for auth tokens)
for cli_config_dir in "gh" "glab-cli"; do
    dir_path="${HOME}/.config/${cli_config_dir}"
    if [[ -d "${dir_path}" ]]; then
        BWRAP_ARGS+=(--bind "${dir_path}" "${dir_path}")
    elif [[ ! -e "${dir_path}" ]]; then
        mkdir -p "${dir_path}"
        BWRAP_ARGS+=(--bind "${dir_path}" "${dir_path}")
    fi
done

# Nix store and configuration (if exists)
if [[ -d /nix ]]; then
    BWRAP_ARGS+=(--ro-bind /nix /nix)
    # Bind Nix configuration if it exists
    [[ -f /etc/nix/nix.conf ]] && BWRAP_ARGS+=(--ro-bind /etc/nix/nix.conf /etc/nix/nix.conf)
fi

# Claude directories (read-write)
BWRAP_ARGS+=(
    --bind "${CLAUDE_DIR}" "${CLAUDE_DIR}"
    --bind "${CLAUDE_TMP}" /tmp/claude
)

# Claude config (always bind if different from .claude)
if [[ "${CLAUDE_CONFIG}" != "${CLAUDE_DIR}" ]]; then
    mkdir -p "${CLAUDE_CONFIG}"
    BWRAP_ARGS+=(--bind "${CLAUDE_CONFIG}" "${CLAUDE_CONFIG}")
fi

# Claude JSON config file
if [[ -f "${HOME}/.claude.json" ]]; then
    BWRAP_ARGS+=(--bind "${HOME}/.claude.json" "${HOME}/.claude.json")
elif [[ ! -e "${HOME}/.claude.json" ]]; then
    # Create empty file so it can be written to
    touch "${HOME}/.claude.json"
    BWRAP_ARGS+=(--bind "${HOME}/.claude.json" "${HOME}/.claude.json")
fi

# Bind ~/.claude/ssh to ~/.ssh (if exists)
if [[ -d "${CLAUDE_DIR}/ssh" ]]; then
    BWRAP_ARGS+=(--bind "${CLAUDE_DIR}/ssh" "${HOME}/.ssh")
fi

# Ruflo directories (read-write, for cross-project memory and coordination)
for ruflo_dir in ".swarm" ".claude-flow" ".hive-mind"; do
    dir_path="${HOME}/${ruflo_dir}"
    if [[ -d "${dir_path}" ]]; then
        BWRAP_ARGS+=(--bind "${dir_path}" "${dir_path}")
    elif [[ ! -e "${dir_path}" ]]; then
        # Create directory if it doesn't exist so it can be written to
        mkdir -p "${dir_path}"
        BWRAP_ARGS+=(--bind "${dir_path}" "${dir_path}")
    fi
done

# Check for enabled optional AppArmor profiles and bind corresponding directories
# Define profile->directories mapping (data-driven approach)
declare -A PROFILE_DIRS=(
    ["emacs-config"]="${HOME}/.config/emacs ${HOME}/.config/doom ${HOME}/.emacs.d ${HOME}/.doom.d"
    ["vim-config"]="${HOME}/.vim ${HOME}/.vimrc ${HOME}/.config/nvim ${HOME}/.local/share/nvim"
    ["browser-config"]="${HOME}/.mozilla ${HOME}/.config/google-chrome ${HOME}/.config/chromium"
    ["full-config-access"]="${HOME}/.config"
)

APPARMOR_LOCAL_UNPRIV="/etc/apparmor.d/local/claude-confined-unpriv"
if [[ -f "${APPARMOR_LOCAL_UNPRIV}" ]]; then
    # Read file once and check for enabled profiles
    local_unpriv_content=$(cat "${APPARMOR_LOCAL_UNPRIV}" 2>/dev/null || true)

    for profile in "${!PROFILE_DIRS[@]}"; do
        if echo "${local_unpriv_content}" | grep -q "claude-confined-optional-${profile}"; then
            # Bind all directories for this profile
            for dir in ${PROFILE_DIRS[$profile]}; do
                if [[ -d "${dir}" ]]; then
                    BWRAP_ARGS+=(--bind "${dir}" "${dir}")
                elif [[ -f "${dir}" ]]; then
                    BWRAP_ARGS+=(--bind "${dir}" "${dir}")
                fi
            done
        fi
    done
fi

# Track paths already bound to avoid duplicates
declare -A BOUND_PATHS
BOUND_PATHS["${CLAUDE_DIR}"]=1
BOUND_PATHS["${CLAUDE_TMP}"]=1
BOUND_PATHS["${CLAUDE_CONFIG}"]=1
BOUND_PATHS["${HOME}/.swarm"]=1
BOUND_PATHS["${HOME}/.claude-flow"]=1
BOUND_PATHS["${HOME}/.hive-mind"]=1

# Add current working directory if not already bound
if [[ ! -v BOUND_PATHS["${INITIAL_CWD}"] ]]; then
    BWRAP_ARGS+=(--bind "${INITIAL_CWD}" "${INITIAL_CWD}")
    BOUND_PATHS["${INITIAL_CWD}"]=1
fi

# Add additional read-write paths
for path_pair in "${ADDITIONAL_RW_PATHS[@]}"; do
    # Split "source:target" pair
    IFS=':' read -r source_path target_path <<< "${path_pair}"
    if [[ ! -e "${source_path}" ]]; then
        echo "Warning: Path does not exist: ${source_path}" >&2
        continue
    fi
    if [[ ! -v BOUND_PATHS["${target_path}"] ]]; then
        BWRAP_ARGS+=(--bind "${source_path}" "${target_path}")
        BOUND_PATHS["${target_path}"]=1
    fi
done

# Add additional read-only paths
for path_pair in "${ADDITIONAL_RO_PATHS[@]}"; do
    # Split "source:target" pair
    IFS=':' read -r source_path target_path <<< "${path_pair}"
    if [[ ! -e "${source_path}" ]]; then
        echo "Warning: Path does not exist: ${source_path}" >&2
        continue
    fi
    if [[ ! -v BOUND_PATHS["${target_path}"] ]]; then
        BWRAP_ARGS+=(--ro-bind "${source_path}" "${target_path}")
        BOUND_PATHS["${target_path}"]=1
    fi
done

# Add environment and namespace settings
# Use user namespace with explicit UID/GID mapping to prevent dangerous remapping
# This ensures UID 1000 inside maps to UID 1000 outside (no privilege escalation)
CURRENT_UID=$(id -u)
CURRENT_GID=$(id -g)

BWRAP_ARGS+=(
    --setenv TMPDIR /tmp/claude
    --setenv XDG_DATA_HOME "${HOME}/.local/share"
    --setenv XDG_CACHE_HOME "${HOME}/.cache"
    --setenv XDG_CONFIG_HOME "${HOME}/.config"
    --setenv CLJ_CONFIG "${HOME}/.clojure"
    --chdir "${INITIAL_CWD}"
    --unshare-user
    --uid "${CURRENT_UID}"
    --gid "${CURRENT_GID}"
    --unshare-ipc
    --unshare-uts
    --die-with-parent
)

# Environment variables are inherited by default in bwrap

# Add seccomp filtering if available
# Find the seccomp generator - check installed location first, then dev location
SECCOMP_GENERATOR=""
if [[ -x "${HOME}/.local/lib/claude-confined/generate-seccomp" ]]; then
    SECCOMP_GENERATOR="${HOME}/.local/lib/claude-confined/generate-seccomp"
else
    # Try relative to script (for development)
    SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    SECCOMP_DIR="${SCRIPT_DIR}/../seccomp"
    if [[ -x "${SECCOMP_DIR}/generate-seccomp" ]]; then
        SECCOMP_GENERATOR="${SECCOMP_DIR}/generate-seccomp"
    elif [[ -x "${SECCOMP_DIR}/compile-seccomp.sh" ]]; then
        # Try to compile if in dev environment
        "${SECCOMP_DIR}/compile-seccomp.sh" 2>/dev/null || true
        if [[ -x "${SECCOMP_DIR}/generate-seccomp" ]]; then
            SECCOMP_GENERATOR="${SECCOMP_DIR}/generate-seccomp"
        fi
    fi
fi

# Use seccomp filter if available and kernel supports it
# Test if seccomp is supported by checking /proc/sys/kernel/seccomp
if [[ -n "${SECCOMP_GENERATOR}" ]] && [[ -e /proc/sys/kernel/seccomp ]]; then
    # Generate BPF filter to temp file (process substitution unreliable with exec)
    SECCOMP_FILTER=$(mktemp)
    if "${SECCOMP_GENERATOR}" > "${SECCOMP_FILTER}" 2>/dev/null; then
        # Pass BPF program via file descriptor 3
        exec 3< "${SECCOMP_FILTER}"
        BWRAP_ARGS+=(--seccomp 3)
        # Clean up temp file after bwrap reads it (bwrap keeps FD open)
        rm -f "${SECCOMP_FILTER}"
    else
        rm -f "${SECCOMP_FILTER}"
    fi
elif [[ -n "${SECCOMP_GENERATOR}" ]] && [[ ! -e /proc/sys/kernel/seccomp ]]; then
    echo "Warning: Seccomp filtering unavailable (kernel not configured with CONFIG_SECCOMP)" >&2
    echo "Continuing with bubblewrap + AppArmor protection only" >&2
fi

# Execute claude with all arguments using bwrap isolation (Linux)
# AppArmor profile is applied automatically via path-based profile matching
if [[ -n "${DEBUG_COMMAND}" ]]; then
    # Debug mode - run arbitrary command
    exec bwrap "${BWRAP_ARGS[@]}" /bin/bash -c "${DEBUG_COMMAND}"
elif [[ "${FLOW_MODE}" == "true" ]]; then
    # Flow mode - run ruflo
    RUFLO_BIN=""
    if command -v ruflo >/dev/null 2>&1; then
        RUFLO_BIN=$(command -v ruflo)
    fi

    if [[ -n "${RUFLO_BIN}" ]]; then
        # Use globally installed ruflo
        RUFLO_REAL=$(readlink -f "${RUFLO_BIN}")
        exec bwrap "${BWRAP_ARGS[@]}" "${RUFLO_REAL}" "${FLOW_ARGS[@]}"
    else
        # Fallback: Use npx to fetch package
        # Support RUFLO_PACKAGE env var for custom package/branch
        FLOW_PACKAGE="${RUFLO_PACKAGE:-ruflo@latest}"
        echo "Warning: ruflo not found globally, using: npx ${FLOW_PACKAGE}" >&2
        NPX_BIN=$(command -v npx)
        if [ -z "${NPX_BIN}" ]; then
            echo "Error: npx not found in PATH" >&2
            exit 1
        fi
        NPX_REAL=$(readlink -f "${NPX_BIN}")
        exec bwrap "${BWRAP_ARGS[@]}" "${NPX_REAL}" "${FLOW_PACKAGE}" "${FLOW_ARGS[@]}"
    fi
else
    # Normal mode - run claude
    exec bwrap "${BWRAP_ARGS[@]}" "${CLAUDE_REAL}" "${CLAUDE_ARGS[@]}"
fi
